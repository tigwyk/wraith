1 ICON "wraith.ico"
2 ICON "wraith-badge.ico"

// WRAITH_VERSION_NUM (e.g. 0,5,2,0) and WRAITH_VERSION_STR ("0.5.2") come from build.rs, from Cargo.toml.
1 VERSIONINFO
FILEVERSION WRAITH_VERSION_NUM
PRODUCTVERSION WRAITH_VERSION_NUM
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Wraith"
      VALUE "FileDescription", "Wraith"
      VALUE "FileVersion", WRAITH_VERSION_STR
      VALUE "ProductVersion", WRAITH_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
